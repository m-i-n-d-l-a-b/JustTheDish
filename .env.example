# Groq API Configuration
# Required: Set your Groq API key from https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# Optional: Groq model to use for recipe extraction
# Default: groq/llama-3.3-70b-versatile
GROQ_MODEL=groq/llama-3.3-70b-versatile

# Optional: Groq request timeout in milliseconds (1-120 seconds)
# Default: 30000 (30 seconds)
GROQ_REQUEST_TIMEOUT=30000

# Optional: Maximum number of retries for failed requests (0-5)
# Default: 2
GROQ_MAX_RETRIES=2

# Optional: Base delay between retries in milliseconds (100-10000)
# Default: 1000 (1 second)
GROQ_RETRY_DELAY=1000

# Optional: Groq feature flags
# If true, apply minimal spacing repair on ingredients when obvious concatenation is detected
# Default: false
GROQ_REPAIR_INGREDIENT_SPACING=false

# Next.js Environment
# Optional: Node.js environment (development, production, test)
# Default: development
NODE_ENV=development

# Optional: Public URL of the application
# Default: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# CORS Configuration
# Optional: Comma-separated list of allowed CORS origins, or * for all
# Default: *
ALLOWED_ORIGINS=*
